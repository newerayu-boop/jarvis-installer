# ─── Telegram ───────────────────────────────────────────────
# @BotFather dan olingan token
BOT_TOKEN=123456:ABC-DEF...

# Botdan foydalanishga ruxsat berilgan Telegram user ID lar (vergul bilan).
# Bo'sh qoldirsangiz — hamma foydalana oladi (tavsiya etilmaydi).
# O'z ID ingizni bilish uchun: @userinfobot ga yozing.
ALLOWED_USER_IDS=

# ─── Public URL (QR link shu yerga ishora qiladi) ───────────
# Deploy qilgandan keyin xizmatingizning to'liq manzili.
# Masalan: https://tickets.suniyintellect.uz  yoki  https://xxx.onrender.com
PUBLIC_URL=http://localhost:3000

# ─── Supabase (biletlar bazasi + QR tekshiruvi uchun) ───────
# Bo'sh qoldirsangiz — lokal data/tickets.json faylga yoziladi (test uchun).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_TABLE=tickets

# ─── Kirishda "Kirdi" tugmasini himoyalash (ixtiyoriy) ──────
# O'rnatilsa — kirishni belgilashda xodim shu PIN ni kiritadi.
STAFF_PIN=

# ─── Server ─────────────────────────────────────────────────
PORT=3000
