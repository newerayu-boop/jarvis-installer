# ─── Telegram ───────────────────────────────────────────────
# @BotFather dan olingan token
BOT_TOKEN=123456:ABC-DEF...

# Botdan foydalanishga ruxsat berilgan Telegram user ID lar (vergul bilan).
# Bo'sh qoldirsangiz — hamma foydalana oladi (tavsiya etilmaydi).
# O'z ID ingizni bilish uchun: @userinfobot ga yozing.
ALLOWED_USER_IDS=

# ─── Faqat Vercel (webhook) uchun ───────────────────────────
# Webhook ni ro'yxatdan o'tkazish uchun maxfiy kalit. Deploy qilgach:
#   https://<loyihangiz>.vercel.app/api/webhook?setup=<SETUP_SECRET>
SETUP_SECRET=change-me-secret
