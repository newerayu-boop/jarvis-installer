{
 "segments": [
  {
   "start": 0.0,
   "end": 9.1,
   "text": "Bilaman suni intilikke qizi qaziz, chalcipiti, cloud, birni madillani qozsiz, lekin baribir siz qoqilagandi naticya ololmayabsiz."
  },
  {
   "start": 9.88,
   "end": 18.08,
   "text": "Man yakim kullardir yana masterclass qiliyatman, bilaman otkansalbar qatnash olmagandiz, bu ikincisi manasizgi yangi imkonyad."
  },
  {
   "start": 18.08,
   "end": 31.14,
   "text": "Albatda kilin, offline boladi, u yirda man qanday qilib cloud orqali uziske ea hodamdan yaratib, bu orqali pul va vaxtingizdi tecahsini kursisi biraman."
  },
  {
   "start": 31.3,
   "end": 37.86,
   "text": "Hamas amaliyyatda boladi, albatdasini kutaman, joylar sonu qegirilanya atiki yusta joy qolga."
  }
 ],
