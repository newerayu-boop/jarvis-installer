{
 "segments": [
  {
   "start": 0.0,
   "end": 5.04,
   "text": "Agar siz hali xam chat gpc chat edi cloud chat di ishlat kiwatkan bo siz,"
  },
  {
   "start": 5.24,
   "end": 8.0,
   "text": "siz vaxti izni behudda sarflawasiz."
  },
  {
   "start": 8.16,
   "end": 11.52,
   "text": "Chunki 90% odamlar chunaqa notoqri ishliydi."
  },
  {
   "start": 11.64,
   "end": 14.32,
   "text": "Chuni uchun, mayimda sizke taklifim bor."
  },
  {
   "start": 14.46,
   "end": 17.18,
   "text": "Yakin kullarda offline tadbir qili yapman,"
  },
  {
   "start": 17.28,
   "end": 20.9,
   "text": "kanday qilib suni intelektini toqri ishlatkan xol etdi,"
  },
  {
   "start": 21.04,
   "end": 24.3,
   "text": "vaxti ingizni va puli ingizni teliyasiti aytib biraman."
  },
  {
   "start": 24.48,
   "end": 27.28,
   "text": "Cloud proyekt, cloud ilovasidi,"
  },
  {
   "start": 27.28,
   "end": 31.34,
   "text": "qanday qilib agentlar və khadimlar yaratisini koristik biramam."
  },
  {
   "start": 31.44,
   "end": 36.26,
   "text": "Uzumda torti adam, yirmati adamni ikini qilib kemoxti."
  },
  {
   "start": 36.36,
   "end": 41.14,
   "text": "Albatda kili cali sana qeklangan hamamani qitib qolamam."
  }
 ],
