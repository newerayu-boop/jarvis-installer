{
 "segments": [
  {
   "start": 0.0,
   "end": 4.32,
   "text": "Odamlarini 90%-i Cloud-tan notogri faydalanidi."
  },
  {
   "start": 4.62,
   "end": 7.88,
   "text": "Nimagin, siz fakat Cloud-chattan faydalanasiz,"
  },
  {
   "start": 7.88,
   "end": 12.1,
   "text": "likin Cloud-proyekt, Cloud-koddi e-xodimlan yaratiq,"
  },
  {
   "start": 12.1,
   "end": 14.94,
   "text": "bu orqali pulizdi tecaz munkilligini bilmisiz."
  },
  {
   "start": 15.1,
   "end": 19.74,
   "text": "Mani ozim, torta xodimin bilan, yirmata xodimin ishini qilib keliyatmiz,"
  },
  {
   "start": 19.82,
   "end": 23.5,
   "text": "va bu orqali vaq, va pulini ekonom qiliyatmiz."
  },
  {
   "start": 23.5,
   "end": 25.0,
   "text": "Ekonomikil yapmiz."
  },
  {
   "start": 25.74,
   "end": 34.44,
   "text": "Agar sizgi ushbu mağzu qızıl boli digan bozir, yakın kullarda man offline tadbir qil yapman."
  },
  {
   "start": 34.68,
   "end": 42.96,
   "text": "Albatda qoşilin, uyirdi qanday qilib, hazırdi aktual boğatgan mamali va yengilikla nasilagi ayitbiraman"
  },
  {
   "start": 42.96,
   "end": 46.48,
   "text": "va sunintilikni toğri isyatisini organib olesiz."
  },
  {
   "start": 47.34,
   "end": 49.54,
   "text": "Cahillar sonu qegirlayngan, albatda kelin."
  }
 ],
